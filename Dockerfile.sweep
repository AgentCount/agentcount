# The weekly sweep, as a Cloud Run Job image.
#
# Separate from `Dockerfile`, which builds the public API, and deliberately so.
# That file's own comment says the sweeper and indexer "are operator tools run
# from a workstation against an RPC endpoint; they have no business in a
# public-facing image" — which is still true. The public API image must not
# carry a binary that holds RPC credentials and writes to every table.
#
# This image is the opposite: it is never served, never reachable from the
# internet, and runs to completion. It carries the binaries a scheduled census
# needs, plus the between-census discovery poller, and nothing else.
#
#   sweeper <chain>   pin a block, read every agent, answer rungs 1-5 and 7
#   liveness <chain>  rung 6 — probe the service endpoints those documents declared
#   delta <chain>     what changed against the previous finished run
#   findings <chain>  the homepage's five figures, counted once so a page load
#                     need not count 1.7 million rows to render them
#   payments <chain>  token transfer logs at the run's pinned block — NOT a rung
#   export-run <run>  rebuild the run's export from the rows it wrote
#   heartbeat         the dead man's switch, pinged only once data is published
#   tail --once       one discovery pass over each chain, between censuses
#
# `scripts/weekly-sweep.sh` is the entrypoint and runs the first seven in that
# order, per chain. The order matters: rung 6 reads documents the sweep
# archived, the delta compares a run that has finished, and the findings
# summarise a run that is complete including rung 6.
#
# `payments` is in the image but OFF in the schedule (`SWEEP_PAYMENTS=1` turns
# it on). It is the longest step, no published figure depends on it, and it is
# equally useful run by hand against one finished run — see METHODOLOGY.md §8.
#
# `tail` is NOT part of that sequence and must not be added to it. It runs on
# its own, far shorter schedule — a second Cloud Run Job on this same image
# with the entrypoint overridden to `/usr/local/bin/tail --once`, fired every
# few minutes by Cloud Scheduler. It is in this image because it needs the same
# RPC credentials and the same database, and in no case in the public API
# image, for the reason at the top of this file.

FROM rust:1-slim-bookworm AS build
WORKDIR /src

# The git SHA this image is built from.
#
# `.dockerignore` excludes `.git` and Cloud Build uploads a tarball anyway, so
# `crates/sweeper/build.rs` cannot ask git and falls back to "unknown" — which
# is what every run of the 2026-08 census recorded. A result that cannot name
# the code that produced it is not reproducible, so the value is passed in.
#
# Empty by default rather than defaulted to something plausible: an unset arg
# leaves the build script's own fallback in charge, which says "unknown"
# honestly instead of naming a commit nobody verified.
ARG CHECKER_COMMIT=""
ENV CHECKER_COMMIT_OVERRIDE=$CHECKER_COMMIT

# Dependencies first, in their own layer — same technique and same reason as
# the API image. Cargo needs every workspace member's manifest and a stub
# source before it will resolve anything.
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY crates/api/Cargo.toml crates/api/
COPY crates/chain/Cargo.toml crates/chain/
COPY crates/checks/Cargo.toml crates/checks/
COPY crates/indexer/Cargo.toml crates/indexer/
COPY crates/payments/Cargo.toml crates/payments/
COPY crates/probe/Cargo.toml crates/probe/
COPY crates/sweeper/Cargo.toml crates/sweeper/
RUN set -eux; \
    for c in api chain checks indexer payments probe sweeper; do \
        mkdir -p "crates/$c/src"; \
        echo 'fn main() {}' > "crates/$c/src/main.rs"; \
        echo '' > "crates/$c/src/lib.rs"; \
    done; \
    mkdir -p crates/sweeper/src/bin; \
    for b in liveness delta findings export-run heartbeat payments tail; do \
        echo 'fn main() {}' > "crates/sweeper/src/bin/$b.rs"; \
    done; \
    cargo build --release -p sweeper || true

COPY crates crates
COPY scripts scripts
# Cargo caches by mtime and the stubs above are newer than what was just
# copied, so without this the release binaries stay `fn main() {}` — silently,
# and the job would "succeed" every week having done nothing.
RUN set -eux; \
    find crates -name '*.rs' -exec touch {} +; \
    cargo build --release -p sweeper; \
    strip target/release/sweeper target/release/liveness target/release/delta \
          target/release/findings target/release/export-run target/release/heartbeat \
          target/release/payments target/release/tail

# ── runtime ──────────────────────────────────────────────────────────────────
#
# Based on the Cloud SDK image rather than `debian:bookworm-slim`, because
# `publish-run.sh` shells out to `gsutil` and there is no lighter honest way to
# get it. An earlier version of this file claimed the SDK arrived "from the
# base layer at deploy time", which was simply not true — nothing would have
# installed it, and the publish step would have failed on the first run with
# `gsutil: not found`.
#
# The image is large (~1 GB against ~120 MB). That is the right trade here and
# would not be for the API: this is a weekly batch job that runs to completion,
# so pull size costs a few seconds once a week, whereas the API is
# scale-to-zero and pays image size on every cold start.
FROM google/cloud-sdk:slim AS runtime
RUN set -eux; \
    apt-get update; \
    # `psql` finds the run id the sweep just finished; `zstd` compresses the
    # archive. Python and gsutil come with the base image. `git` is NOT here:
    # the job publishes the index to the bucket and the commit is a human step
    # taken when the week's report is written — see `weekly-sweep.sh`.
    apt-get install -y --no-install-recommends postgresql-client zstd; \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /src/target/release/sweeper /usr/local/bin/sweeper
COPY --from=build /src/target/release/liveness /usr/local/bin/liveness
COPY --from=build /src/target/release/delta /usr/local/bin/delta
COPY --from=build /src/target/release/findings /usr/local/bin/findings
COPY --from=build /src/target/release/export-run /usr/local/bin/export-run
COPY --from=build /src/target/release/heartbeat /usr/local/bin/heartbeat
COPY --from=build /src/target/release/payments /usr/local/bin/payments
COPY --from=build /src/target/release/tail /usr/local/bin/tail
COPY scripts/ /opt/agentcount/scripts/
# `chmod` in a RUN rather than `COPY --chmod`, which needs BuildKit — Cloud
# Build's docker builder does not enable it, and the build fails outright.
RUN chmod 755 /opt/agentcount/scripts/*.sh \
    && ln -s /opt/agentcount/scripts/weekly-sweep.sh /usr/local/bin/weekly-sweep

# `publish-run.sh` is invoked as `./scripts/publish-run.sh` and writes
# `published-runs.json` and `data/` relative to the working directory, so the
# job runs from a writable directory that has `scripts/` beneath it.
WORKDIR /opt/agentcount

# Non-root. This process holds RPC credentials and a database password; there
# is no reason for it to also be root. Created after the copies so the chmod
# above still runs as root, and given the workdir so the export can be written.
RUN useradd --system --create-home --shell /usr/sbin/nologin agentcount \
    && chown -R agentcount:agentcount /opt/agentcount
USER agentcount

ENV RUST_LOG=info
ENTRYPOINT ["/usr/local/bin/weekly-sweep"]
